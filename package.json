{
  "name": "upto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build-storybook": "pnpm --filter @upto/web build-storybook",
    "db:generate": "pnpm --filter @upto/db db:generate",
    "db:migrate": "pnpm --filter @upto/db db:migrate",
    "dev": "pnpm --parallel --filter @upto/web --filter @upto/collector dev",
    "dev:collector": "pnpm --filter @upto/collector dev",
    "dev:web": "pnpm --filter @upto/web dev",
    "format": "oxfmt . \"!docs/**\" \"!AGENTS.md\"",
    "format:check": "oxfmt --check . \"!docs/**\" \"!AGENTS.md\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "storybook": "pnpm --filter @upto/web storybook",
    "storymesh:check": "pnpm storymesh:index && storymesh spec check --spec-dir .storymesh/specs --index apps/web/storybook-static/index.json",
    "storymesh:index": "pnpm --filter @upto/web exec storybook index --disable-telemetry -c .storybook -o storybook-static/index.json",
    "storymesh:report": "storymesh report apps/web/src --framework react",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:vrt": "sh apps/web/e2e/visual/run.sh",
    "test:vrt:update": "sh apps/web/e2e/visual/run.sh --update-snapshots",
    "test:watch": "vitest",
    "trigger:deploy:dry-run": "pnpm --dir apps/collector run trigger:deploy:dry-run",
    "trigger:deploy:prod": "pnpm --dir apps/collector run trigger:deploy:prod",
    "trigger:deploy:staging": "pnpm --dir apps/collector run trigger:deploy:staging",
    "trigger:dev": "pnpm --dir apps/collector run trigger:dev",
    "typecheck": "tsc -b",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:storybook": "pnpm --filter @upto/web test:storybook"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "storymesh": "0.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.8.1"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "@opentelemetry/core": "3.0.0",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "cookie": "0.7.2",
      "deepmerge-ts": "8.0.2",
      "engine.io": "6.6.11",
      "esbuild": "0.28.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "giget": "2.0.0",
      "hono@>=4.0.0 <4.13.11": "4.13.14",
      "ip-address@>=10.0.0 <10.7.4": "10.7.5",
      "nanoid": "3.3.20",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "ws": "8.22.0",
      "zod@>=4.0.0 <4.6.6": "4.6.7"
    }
  }
}
