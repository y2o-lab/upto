# Copy this file to backend.hcl and replace every placeholder. It contains no
# credentials: Terraform reads AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY from
# the environment for the Cloudflare R2 S3-compatible API.
bucket   = "<r2-state-bucket-name>"
key      = "upto/production/terraform.tfstate"
region   = "auto"
endpoints = {
  s3 = "https://<cloudflare-account-id>.r2.cloudflarestorage.com"
}

# Required compatibility options for Cloudflare R2's S3 API.
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
use_lockfile                = true
