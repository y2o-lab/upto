FROM docker:27.5.1-cli AS docker-cli

FROM node:24-slim AS dependencies
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/collector/package.json apps/collector/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/domain/package.json packages/domain/package.json
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
COPY trigger.config.ts ./trigger.config.ts
COPY apps/collector apps/collector
COPY packages/db packages/db
COPY packages/domain packages/domain
RUN pnpm --filter @upto/collector test \
  && pnpm --filter @upto/collector typecheck \
  && pnpm --filter @upto/collector build

FROM node:24-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --chown=node:node --from=build /app /app

ARG SOURCE_COMMIT=unknown
ENV SOURCE_COMMIT=${SOURCE_COMMIT}

USER node
CMD ["sleep", "infinity"]
