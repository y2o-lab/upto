DATABASE_URL=postgres://upto:upto@localhost:5432/upto
DIRECT_DATABASE_URL=postgres://upto:upto@localhost:5432/upto
DATABASE_POOL_MAX=2
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=gemini-3.1-flash-lite
GEMINI_MODEL_IMPORTANT=gemini-3.0-flash
DEBUG=false
COLLECTOR_DRY_RUN=true
COLLECTOR_CONCURRENCY=2
COLLECTOR_MAX_ITEMS_PER_FEED=20
SUMMARY_CHUNK_CHARS=12000

# Trigger.dev local development and non-interactive deployment
TRIGGER_API_URL=
TRIGGER_ACCESS_TOKEN=
TRIGGER_PROJECT_REF=

# Coolify Trigger.dev deploy resource only
TRIGGER_DEPLOY_ENV=staging
TRIGGER_REGISTRY_HOST=
TRIGGER_REGISTRY_USERNAME=
TRIGGER_REGISTRY_PASSWORD=
DOCKER_HOST=
DOCKER_TLS_VERIFY=1
DOCKER_CERT_PATH=/run/secrets/docker
